{
  "manifest_version": 3,
  "name": "Deep Work Agent",
  "version": "2.0.0",
  "description": "AI-powered browser monitoring for deep work focus",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/overlay.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deep Work Agent"
  }
}
